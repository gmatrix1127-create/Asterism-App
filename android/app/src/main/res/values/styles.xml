<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryDark">@color/app_bg</item>
        <item name="colorAccent">@color/brand_green</item>
    </style>

    <!-- DayNight：让网页里的“跟随系统”能读到系统深浅色 -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <!-- 启动画面：背景和页面同色，Logo 一笔画出来，网页准备好后淡出（见 MainActivity） -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- app 里手动选了浅色 / 深色时，下次启动改用这两套（安卓 13 起，见 LaunchPlugin） -->
    <style name="SplashDay" parent="AppTheme.NoActionBarLaunch">
        <item name="windowSplashScreenBackground">#F5F8F6</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_day</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="SplashNight" parent="AppTheme.NoActionBarLaunch">
        <item name="windowSplashScreenBackground">#0D1311</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
